# Docker image implementing the configured runner.
FLUJO_RUNNER_IMAGE=flujo-comfy:cu130
# Host directory containing ComfyUI model subdirectories.
FLUJO_MODELS_DIR=/absolute/path/to/comfy-models
# Optional override for runner diffusion models. Mounted over the root model
# directory's diffusion_models subdirectory.
FLUJO_DIFFUSION_MODELS_DIR=/absolute/path/to/diffusion-models
# Use "toolkit" on hosts with NVIDIA Container Toolkit; the default uses
# explicit NVIDIA device and driver mounts for this development machine.
FLUJO_DOCKER_GPU_MODE=devices
# Set for a frontend hosted separately from the Flujo backend.
VITE_FLUJO_API_URL=http://localhost:4000
