# Never commit the real values.
RUNPOD_API_KEY=
FLUJO_PROVIDER=local
# Local ComfyUI is Flujo's default provider.
# Backend address of this machine's LAN-bound ComfyUI.
COMFYUI_URL=http://comfy:8188
# Address a phone on your LAN can reach. Replace with this machine's LAN IP.
COMFYUI_PUBLIC_URL=http://192.168.1.100:8188
FLUJO_LAN_IP=192.168.1.100
FLUJO_PHONE_ORIGIN=http://192.168.1.100:8080
